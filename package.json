{
    "name": "GitSearch",
    "description": "A web application for getting basic info of a git user with follow functionality.",
    "keywords": [
        "Git",
        "Search"
    ],
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:no-strict": "cross-env VITE_DISABLE_STRICT_MODE=true vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --verbose",
        "lint": "eslint .",
        "prettier": "prettier --write .",
        "prettier:check": "prettier --check .",
        "prepare": "husky",
        "pre-commit": "lint-staged",
        "pre-push": "lint-staged",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.3.0",
        "@mui/icons-material": "^9.4.0",
        "@mui/material": "^9.4.0",
        "@reduxjs/toolkit": "^2.12.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-redux": "^9.3.0",
        "react-router": "^8.3.1"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@testing-library/react": "^16.3.3",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-react": "^6.1.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.5.0",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.1"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,html}": [
            "prettier --write"
        ]
    },
    "resolutions": {
        "@typescript-eslint/parser": "^8.70.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0"
    }
}
